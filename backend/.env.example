# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/
DB_NAME=vivek_data

# Server Configuration
PORT=3000
NODE_ENV=development
TRUST_PROXY=1

# CORS Configuration (add your Vercel URL after deploy)
FRONTEND_URLS=http://localhost:5173,https://your-vercel-domain.vercel.app

# Admin Secret
ADMIN_SECRET=choose-a-strong-secret
PROJECT_ACCESS_SECRET=choose-a-separate-strong-secret
ADMIN_LOGIN_RATE_WINDOW_MS=900000
ADMIN_LOGIN_MAX_ATTEMPTS=8

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Chatbot Protection
CHATBOT_RATE_WINDOW_MS=60000
CHATBOT_MAX_REQUESTS_PER_WINDOW=8
CHATBOT_DAILY_LIMIT=80
CHATBOT_BODY_LIMIT=20kb
CHATBOT_MAX_MESSAGE_CHARS=500
CHATBOT_MAX_HISTORY_ITEMS=12
CHATBOT_MAX_HISTORY_CHARS=500

# Feedback Protection
FEEDBACK_RATE_WINDOW_MS=600000
FEEDBACK_RATE_MAX_REQUESTS=20
FEEDBACK_BODY_LIMIT=10kb

# Project PIN Protection
PROJECT_PIN_RATE_WINDOW_MS=600000
PROJECT_PIN_MAX_ATTEMPTS=10
